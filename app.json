{
  "expo": {
    "name": "Pousse",
    "slug": "pousse",
    "version": "1.2.0",
    "scheme": "pousse",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.pousse.plants",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Pousse uses your camera to take a photo of a plant so it can identify the species and suggest how to care for it.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Pousse uses your location.",
        "NSPhotoLibraryUsageDescription": "Pousse needs your photos to identify your plants."
      }
    },
    "android": {
      "package": "app.pousse.plants",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_CONTACTS",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      ["expo-location", { "isIosBackgroundLocationEnabled": true }],
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-0000000000000000~0000000000",
          "iosAppId": "ca-app-pub-0000000000000000~0000000000"
        }
      ]
    ]
  }
}
